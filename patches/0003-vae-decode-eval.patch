+                #     row.append(self.decoder(self.post_quant_conv(tile)))
+                # `decode()` (below) chains 13 chunks x 15 tiles = up to 195 of these ViT forwards
+                # into a single lazy MLX graph and only materializes it once, at the very end, with
+                # one `np.array()` call. Under allocator/memory pressure a fraction of that graph's
+                # intermediate buffers can come back as an unwritten (zero) or garbled buffer
+                # instead of the tile this call actually computed -- non-deterministically, and
+                # invisible to any shape/dtype check, because the corrupt buffer is still a
+                # well-formed array. `mx.eval` right here forces this one tile to materialize on
+                # its own terms, immediately, exactly as `self.decoder`/`self.post_quant_conv`
+                # computed it -- a pure materialization, so the value is bit-identical to the
+                # unpatched graph's eventual output; only *when* it is pinned down changes. See
+                # `docs/RESULTS.md` for the corruption repro this closes.
+                decoded_tile = self.decoder(self.post_quant_conv(tile))
+                mx.eval(decoded_tile)
+                row.append(decoded_tile)
